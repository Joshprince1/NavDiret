{
  "expo": {
    "name": "NavDiret",
    "slug": "NavDiret",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.navdiret.app"
    },
    "android": {
      "package": "com.navdiret.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow NavDiret to use your location while you use the app to identify your current place and improve navigation.",
          "locationAlwaysAndWhenInUsePermission": "Allow NavDiret to keep using your location for travel tracking when you choose to enable background location in a native build.",
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      "./plugins/withMapLibreBuildConfig",
      "./plugins/withAndroidKotlinVersion",
      "expo-sqlite"
    ],
    "extra": {
      "routingBaseUrl": {},
      "geocodingBaseUrl": {},
      "routingProfile": "driving",
      "eas": {
        "projectId": "1ca21f11-fd02-4e6c-be0a-edaae0bb251a"
      }
    },
    "owner": "joshuawins-team"
  }
}
